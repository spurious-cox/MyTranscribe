<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime (required for notarization) blocks things
	     CPython and torch do normally:
	       allow-unsigned-executable-memory  CPython and numba write executable pages
	       allow-jit                         numba / llvmlite JIT
	       disable-library-validation        load the bundle's .so files
	     and the microphone needs its own entitlement under it. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
